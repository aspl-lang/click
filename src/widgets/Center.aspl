import graphics
import math.geometry

import click.layouting
import click.drawing

[public]
class Center extends Widget, WidgetContainer {

    property Widget child

    [public]
    method construct(Widget child){
        this.child = child

        this.sizing = new Sizing(new LooseAxisSizing(), new LooseAxisSizing())
    }

    [public]
    method getChildren() returns list<Widget>{
        return [child]
    }

    [public]
    method performChildrenSizing(Constraints constraints) returns Size{
        child.chooseSizeAndPerformChildrenSizing(constraints)
        return child.size
    }

    [public]
    method performChildrenPositioning(){
        child.assignPositionAndPerformChildrenPositioning(new Point((this.size.width - child.size.width) / 2, (this.size.height - child.size.height) / 2))
    }

    [public]
    method draw(CanvasRegion canvas){
        drawChildrenDefault(canvas)
    }

}